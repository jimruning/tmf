# Vercel Postgres Connection
# Get these from Vercel Dashboard > Storage > Create Database > PostgreSQL
POSTGRES_URL=postgres://user:password@host:port/database?sslmode=require

# JWT Secret (change to a random string in production)
JWT_SECRET=tmf-production-secret-key-change-this

# Environment
NODE_ENV=production

# File Upload
MAX_FILE_SIZE=104857600
