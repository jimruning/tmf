{
  "buildCommand": "cd backend && npm install && cd ../frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[[...index]]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "JWT_SECRET": "tmf-production-secret-key-change-this",
    "NODE_ENV": "production"
  },
  "functions": {
    "api/[[...index]].js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
